{
  "name": "qap-rag",
  "version": "1.0.0",
  "description": "Backend RAG do QAP IA",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "node src/scripts/fix-document-resolution.js",
    "build": "tsc",
    "test": "SUPABASE_URL=http://localhost:54321 SUPABASE_SERVICE_ROLE_KEY=dummy_key GROQ_API_KEY=dummy_key node --import tsx --test src/**/*.test.ts",
    "migrate-vectors": "tsx src/scripts/migrate-vectors.ts",
    "rag:evaluate": "SUPABASE_URL=http://localhost:54321 SUPABASE_SERVICE_ROLE_KEY=dummy_key tsx src/scripts/evaluate-rag.ts",
    "rag:inspect": "tsx src/scripts/inspect-rag.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "httpyac": "^6.16.7",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
