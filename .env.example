# Configurações do Supabase
SUPABASE_URL=https://sua-url-do-supabase.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-do-supabase

# Configuração da API do Groq (única chave para Embeddings e Chat)
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Configurações do Servidor
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=https://qap-ia.lovable.app,http://localhost:5173

# Configurações de RAG (Padrões)
DEFAULT_TOP_K=5
DEFAULT_MIN_SCORE=0.3
DEFAULT_MAX_CONTEXT_SIZE=4000

# Cache de Embeddings (Opcional - Configurações de Produção)
EMBEDDING_CACHE_TTL=86400
EMBEDDING_CACHE_MAX_SIZE=1000

# Limites e Retentativas de IA (Opcional - Configurações de Produção)
LLM_TIMEOUT=25000
LLM_RETRIES=3
LLM_RETRY_DELAY=1000

# Circuit Breaker (Opcional - Configurações de Produção)
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN=30000

# Rate Limiting por IP (Opcional - Configurações de Produção)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_CHAT=100
RATE_LIMIT_MAX_SEARCH=100
RATE_LIMIT_MAX_INDEX=20
